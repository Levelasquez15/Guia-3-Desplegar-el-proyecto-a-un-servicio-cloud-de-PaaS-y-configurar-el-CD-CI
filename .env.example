# Variables de entorno para ejecucion local y despliegue en PaaS (Render)
# Copia este archivo como .env (en local) o configuralas en el panel Environment de Render.
# NUNCA subas el archivo .env ni credenciales reales al repositorio Git.

# Base de datos MySQL remota (Aiven)
DB_HOST=tu-host-mysql.aivencloud.com
DB_PORT=17215
DB_NAME=crud_usuarios
DB_USERNAME=avnadmin
DB_PASSWORD=tu_password_aiven
DB_SSL_MODE=REQUIRED

# Servidor de Correo SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_gmail
SMTP_FROM_ADDRESS=tu_correo@gmail.com
SMTP_FROM_NAME=Gestion de Usuarios

# Seguridad JWT (minimo 32 bytes codificados en Base64; en Render Blueprint se autogenera)
JWT_SECRET=reemplaza-por-un-secreto-base64-de-32-bytes-en-produccion
JWT_EXPIRATION_SECONDS=900
